@model backend.Models.Product

@{
    ViewData["Title"] = "ProductView";
}

<div>
    <a asp-action="Index">Back to List</a>
</div>


<h4>Product</h4>
<hr />
<div class="row">
    <div class="col">
        <form asp-action="ProductView" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
           <div class="row">
               <div class="col">
                    <div class="form-group">
                        <label asp-for="ProductCode" class="control-label">Product Code</label>
                        <input asp-for="ProductCode" class="form-control" />
                        <span asp-validation-for="ProductCode" class="text-danger"></span>
                    </div>
               </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="ProductName" class="control-label">Product Name</label>
                        <input asp-for="ProductName" class="form-control" />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="ProductType" class="control-label">ProductType</label>
                        <select id="DropdownProductType" asp-for="ProductType" class="form-control">
                            <option value="0">-- Select --</option>
                            <option value="1">T-Shirt(Oversized)</option>
                            <option value="2">T-Shirt(Regular)</option>
                            <option value="3">Shirt</option>
                            <option value="4">Cap</option>
                        </select>
                        <span asp-validation-for="ProductType" class="text-danger"></span>
                    </div>
                </div>                
           </div>
           <div class="row">
            <div class="col">
                <div class="form-group">
                    <label asp-for="Color" class="control-label">Color</label>
                    <input asp-for="Color" class="form-control" placeholder="e.g. Black, White, Navy" />
                    <span asp-validation-for="Color" class="text-danger"></span>
                </div>
            </div>
        </div>
            <div class="row">
                <div class="col">
                    <div id="size-container">
                        <div class="row mb-2 size-row">
                            <div class="col">
                                <label class="control-label">Sizes</label>
                                <select name="SizeValues" class="form-control">
                                    <option value="">-- Select Size --</option>
                                    <option value="S">S</option>
                                    <option value="M">M</option>
                                    <option value="L">L</option>
                                    <option value="XL">XL</option>
                                </select>
                            </div>
                            <div class="col">
                                <label class="control-label">Stock Quantity</label>
                                <input type="number" name="StockQuantities" class="form-control" placeholder="Stock Quantity" min="0" />
                            </div>
                            <div class="col d-flex align-items-end">
                                <button type="button" class="btn btn-danger remove-size ">Remove</button>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="add-size" class="btn btn-secondary mb-3">Add Size</button>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label asp-for="OldPrice" class="control-label">Old Price</label>
                        <input asp-for="OldPrice" class="form-control" />
                        
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="NewPrice" class="control-label">Price</label>
                        <input asp-for="NewPrice" class="form-control" />
                        <span asp-validation-for="NewPrice" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label asp-for="Category" class="control-label">Category</label>
                        <select id="DropdownCategory" asp-for="Category" class="form-control">
                            <option value="0">-- Select --</option>
                            <option value="1">Men</option>
                            <option value="2">Women</option>
                            <option value="3">Unisex</option>
                            <option value="4">Accessories</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label asp-for="CollectionId" class="control-label">Collection</label>
                        <select asp-for="CollectionId"
                                asp-items="@(new SelectList(ViewBag.Collections, "CollectionId", "CollectionName"))"
                                class="form-control">
                            <option value="">-- Select Collection --</option>
                        </select>

                        <span asp-validation-for="CollectionId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col">
                    <div class="form-group">
                        <label>Image 1</label>
                        <input type="file" name="ImageFiles" class="form-control" />
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label>Image 2</label>
                        <input type="file" name="ImageFiles" class="form-control" />
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label>Image 3</label>
                        <input type="file" name="ImageFiles" class="form-control" />
                    </div>
                </div>
                <div class="col">
                    <div class="form-group">
                        <label>Image 4</label>
                        <input type="file" name="ImageFiles" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-group" style="padding-top:20px;">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



