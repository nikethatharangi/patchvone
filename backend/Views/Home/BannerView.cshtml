@model backend.Models.Banner

@{
    ViewData["Title"] = "BannerView";
}

<div>
    <a asp-action="Index">Back to List</a>
</div>

<h4>Banner</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="BannerView" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="BannerName" class="control-label">Banner</label>
                <input type="file" name="BannerImage" class="form-control" />
                <span asp-validation-for="BannerName" class="text-danger"></span>
            </div>

            <div class="form-group" style="padding-top:20px;">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>

    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
