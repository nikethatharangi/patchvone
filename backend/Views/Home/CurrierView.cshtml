@model backend.Models.Courier

@{
    ViewData["Title"] = "CurrierView";
}

<h4>Courier</h4>
<h3></h3>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="CurrierView">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CourierName" class="control-label"></label>
                <input asp-for="CourierName" class="form-control" />
                <span asp-validation-for="CourierName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CurrentDeliveryCharge" class="control-label"></label>
                <input asp-for="CurrentDeliveryCharge" class="form-control" />
                <span asp-validation-for="CurrentDeliveryCharge" class="text-danger"></span>
            </div>
           
            <div class="form-group" style="padding-top:20px;">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
