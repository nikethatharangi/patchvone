@{
    ViewData["Title"] = "Home Page";
    var products = (List<backend.Models.Product>)ViewBag.ProductList;
    var banners = (List<backend.Models.Banner>)ViewBag.Banners;
    var collections = (List<backend.Models.ProductCollection>)ViewBag.CollectionList;
}
@using System.Text.Json
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto|Varela+Round|Open+Sans">
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/css/bootstrap.min.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>
<style>

table.table td a {
    cursor: pointer;
    display: inline-block;
    margin: 0 5px;
    min-width: 24px;
}
table.table td a.edit {
    color: #FFC107;
}
table.table td a.delete {
    color: #E34724;
}
</style>

<div class="text-center">
   
    
    <h3>Banner</h3>
    <div style="padding-top:20px;">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>BannerId</th>
                    <th>Banner</th>
                    <th>Banner Text</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in banners)
                {
                    <tr>
                        <td>@item.BannerId</td>
                        <td><img src="@Url.Content(item.BannerPath)" style="width:200px"></td>
                        <td>@item.BannerText</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3>Product Collection List</h3>
    <div style="padding-top:20px;">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>CollectionId</th>
                    <th>CollectionName</th>
                    <th>CollectionType</th>
                    <th>Is Deleted</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in collections)
                {
                    <tr>
                        <td>@item.CollectionId</td>
                        <td>@item.CollectionName</td>
                        <td>
                            @{
                                if (item.ColletionType == "1")
                                {
                                    @: Men
                                }
                                else if (item.ColletionType == "2")
                                {
                                    @: Women
                                }
                                else if (item.ColletionType == "3")
                                {
                                    @: Unisex
                                }
                                else if (item.ColletionType == "4")
                                {
                                    @: Accessories
                                }
                            }
                        </td>
                        <td>@(item.IsDeleted ? "Yes" : "No")</td>
                        <td> 
                            <a class="edit-collection"
                            data-id="@item.CollectionId"
                            data-name="@item.CollectionName"
                            data-type="@item.ColletionType">
                                <i class="material-icons">&#xE254;</i>
                            </a>

                            <a href="/Home/DeleteCollection/@item.CollectionId"
                            class="delete"
                            onclick="return confirm('Are you sure you want to delete this collection?')">
                                <i class="material-icons">&#xE872;</i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Collection pagination">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.CollectionPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                    href="@Url.Action("IndexPagination", new { collectionPage = ViewBag.CollectionPage - 1, productPage = ViewBag.ProductPage })">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.CollectionTotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CollectionPage ? "active" : "")">
                        <a class="page-link"
                        href="@Url.Action("IndexPagination", new { collectionPage = i, productPage = ViewBag.ProductPage })">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.CollectionPage == ViewBag.CollectionTotalPages ? "disabled" : "")">
                    <a class="page-link"
                    href="@Url.Action("IndexPagination", new { collectionPage = ViewBag.CollectionPage + 1, productPage = ViewBag.ProductPage })">
                        Next
                    </a>
                </li>

            </ul>
        </nav>

    </div>


    <h3>Product List</h3>
    <div style="padding-top:20px;">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>ProductCode</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Size : Qty</th>
                    <th>Color</th>
                    <th>Old Price</th>
                    <th>New Price</th>
                    <th>Category</th>
                    <th>Collection</th>
                    <th>isDeleted</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in products)
                {
                    <tr>
                        <td>@item.ProductCode</td>
                        <td>@item.ProductName</td>
                        <td>
                            @{
                                if(item.ProductType == "1")
                                {
                                    @: T-Shirt(Oversized)
                                }
                                else if (item.ProductType == "2")
                                {
                                    @: T-Shirt(Regular)
                                }
                                else if (item.ProductType == "3")
                                {
                                    @: Shirt
                                }
                                else if (item.ProductType == "4")
                                {
                                    @: Cap
								}
                            }
                        </td>
                        <td>
                            @if(item.Sizes != null && item.Sizes.Any())
                            {
                                foreach(var s in item.Sizes)
                                {
                                    <div>@s.SizeValue : @s.StockQuantity</div>
                                }
                            }
                            else
                            {
                                <div>N/A</div>
                            }
                                                    </td>
                        <td>@item.Color</td>
                        <td>@item.OldPrice</td>
                        <td>@item.NewPrice</td>
                        <td>
                            @{
                                if(item.Category == "1")
                                {
									@: Men
                                }
                                else if (item.Category == "2")
                                {
                                    @: Women
                                }
                                else if (item.Category == "3")
                                {
                                    @: Unisex
								}
                                else if (item.Category == "4")
                                {
                                    @: Accessories
                                }
                            }
                        </td>
                        <td>@item.ProductCollection?.CollectionName</td>
                        <td>@(item.isDeleted ? "Yes" : "No")</td>
                        <td>
                            <a class="edit-product"
                                data-product-id="@item.ProductId"
                                data-product-code="@item.ProductCode"
                                data-product-name="@item.ProductName"
                                data-product-type="@item.ProductType"
                                data-old-price="@item.OldPrice"
                                data-new-price="@item.NewPrice"
                                data-color="@item.Color"
                                data-category="@item.Category"
                                data-collection-id="@item.CollectionId"
                                data-sizes='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Sizes))'>
                                <i class="material-icons">&#xE254;</i>
                                </a>
                            <a href="/Home/DeleteProduct/@item.ProductId" class="delete" title="Delete" data-toggle="tooltip" onclick="return confirm('Are you sure you want to delete this product?')"><i class="material-icons">&#xE872;</i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Product pagination">
            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.ProductPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                    href="@Url.Action("IndexPagination", new { productPage = ViewBag.ProductPage - 1, collectionPage = ViewBag.CollectionPage })">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.ProductTotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.ProductPage ? "active" : "")">
                        <a class="page-link"
                        href="@Url.Action("IndexPagination", new { productPage = i, collectionPage = ViewBag.CollectionPage })">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(ViewBag.ProductPage == ViewBag.ProductTotalPages ? "disabled" : "")">
                    <a class="page-link"
                    href="@Url.Action("IndexPagination", new { productPage = ViewBag.ProductPage + 1, collectionPage = ViewBag.CollectionPage })">
                        Next
                    </a>
                </li>

            </ul>
        </nav>

    </div>

</div>
<script>
    $('#myModal').on('shown.bs.modal', function () {
      $('#myInput').trigger('focus')
    })

    $(document).on('click', '.edit-product', function () {

    $('#editProductId').val($(this).data('product-id'));
    $('#editProductCode').val($(this).data('product-code'));
    $('#editProductName').val($(this).data('product-name'));
    $('#editProductType').val($(this).data('product-type'));
    $('#editOldPrice').val($(this).data('old-price'));
    $('#editNewPrice').val($(this).data('new-price'));
    $('#editColor').val($(this).data('color'));
    $('#editCategory').val($(this).data('category'));
    $('#editCollectionId').val($(this).data('collection-id'));

    var sizes = $(this).data('sizes') || [];

    $('#sizesContainer').empty();

    if (Array.isArray(sizes)) {
        sizes.forEach(function (s) {
            $('#sizesContainer').append(`
                <div class="d-flex mb-2">
                    <input type="text" class="form-control mr-2"
                           name="SizeValues"
                           value="${s.SizeValue}"
                           placeholder="Size" />
                    <input type="number" class="form-control"
                           name="StockQuantities"
                           value="${s.StockQuantity}"
                           placeholder="Stock" />
                </div>
            `);
        });
    }

    $('#editProductModal').modal('show');
});

$(document).on('click', '.edit-collection', function () {
    console.log('Edit clicked, data:', $(this).data()); // Check F12 console
    
    var id = $(this).data('id');
    var name = $(this).data('name');
    var type = $(this).data('type');
    
    $('#editProductCollectionId').val($(this).data('id'));
    $('#editCollectionName').val($(this).data('name'));
    $('#editCollectionType').val($(this).data('type'));
    $('#editCollectionModal').modal('show');
});
</script>


<!-- Modal -->
<div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Modal title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Product Modal -->
<div class="modal fade" id="editProductModal" tabindex="-1" role="dialog" aria-labelledby="editProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editProductModalLabel">Edit Product</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form action="/Home/EditProduct" method="post">
                <div class="modal-body">
                    <input type="hidden" id="editProductId" name="ProductId" />
                    <div class="form-group">
                        <label for="editProductCode">Product Code</label>
                        <input type="text" class="form-control" id="editProductCode" name="ProductCode" required />
                    </div>
                    <div class="form-group">
                        <label for="editProductName">Product Name</label>
                        <input type="text" class="form-control" id="editProductName" name="ProductName" required />
                    </div>
                    <div class="form-group">
                        <label for="editProductType">Product Type</label>
                        <select class="form-control" id="editProductType" name="ProductType">
                            <option value="1">T-Shirt(Oversized)</option>
                            <option value="2">T-Shirt(Regular)</option>
                            <option value="3">Shirt</option>
                            <option value="4">Cap</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editOldPrice">Old Price</label>
                        <input type="number" step="0.01" class="form-control" id="editOldPrice" name="OldPrice" />
                    </div>
                    <div class="form-group">
                        <label for="editNewPrice">New Price</label>
                        <input type="number" step="0.01" class="form-control" id="editNewPrice" name="NewPrice" required />
                    </div>
                    <div class="form-group">
                        <label for="editColor">Color</label>
                        <input type="text" class="form-control" id="editColor" name="Color" />
                    </div>
                    <div class="form-group">
                        <label for="editCategory">Category</label>
                        <select class="form-control" id="editCategory" name="Category">
                            <option value="1">Men</option>
                            <option value="2">Women</option>
                            <option value="3">Unisex</option>
                            <option value="4">Accessories</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editCollectionId">Collection</label>
                        <select class="form-control" id="editCollectionId" name="CollectionId">
                            @foreach (var col in collections)
                            {
                                <option value="@col.CollectionId">@col.CollectionName</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Sizes</label>
                        <div id="sizesContainer"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Collection Modal -->
<div class="modal fade" id="editCollectionModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Edit Collection</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>

            <form action="/Home/EditCollection" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editProductCollectionId" name="CollectionId" />

                <div class="form-group">
                    <label>Collection Name</label>
                    <input type="text"
                        id="editCollectionName"
                        name="CollectionName"
                        class="form-control"
                        required />
                </div>

                <div class="form-group">
                    <label>Collection Type</label>
                    <select id="editCollectionType"
                            name="ColletionType"
                            class="form-control"
                            disabled>
                        <option value="1">Men</option>
                        <option value="2">Women</option>
                        <option value="3">Unisex</option>
                        <option value="4">Accessories</option>
                    </select>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>

        </div>
    </div>
</div>



