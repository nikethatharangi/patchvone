@model backend.Models.ProductCollection

@{
    ViewData["Title"] = "ProductCollectionView";
}


<div>
    <a asp-action="Index">Back to List</a>
</div>

<h4>ProductCollection</h4>
<hr />
<div class="row">
    <div class="col-md-2">
        <form asp-action="ProductCollectionView" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CollectionName" class="control-label">Collection Name</label>
                <input asp-for="CollectionName" class="form-control" />
                <span asp-validation-for="CollectionName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ColletionType" class="control-label">Category</label>
                <select id="DropdownCollectionCategory" asp-for="ColletionType" class="form-control">
                    <option value="0">-- Select --</option>
                    <option value="1">Men</option>
                    <option value="2">Women</option>
                    <option value="3">Unisex</option>
                    <option value="4">Accessories</option>
                </select>
                <span asp-validation-for="ColletionType" class="text-danger"></span>
            </div>
            <div class="form-group" style="padding-top:20px;">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
